# ============================================================
# Cloudflare Domain Manager Bot — Environment Variables
# ============================================================
# File ini adalah TEMPLATE. JANGAN isi nilai asli di sini.
#
# Cara pakai:
#   1. Copy ke .env lokal (untuk referensi pribadi):
#        cp .env.example .env
#   2. Isi nilai asli di .env
#   3. Untuk deploy ke Cloudflare, gunakan salah satu:
#      - Dashboard: Worker → Settings → Variables and Secrets
#
# ============================================================

# ------------------------------------------------------------
# WAJIB — Tanpa ini bot tidak berjalan
# ------------------------------------------------------------

# Token bot dari @BotFather
# Format: <bot_id>:<auth_hash>  contoh: 123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_BOT_TOKEN=

# Password untuk melindungi endpoint /admin/* dan /telegram/setup
# Generate dengan: openssl rand -hex 32
# Panjang minimal 32 karakter. Jangan pakai kata yang mudah ditebak.
ADMIN_TOKEN=


# ------------------------------------------------------------
# SANGAT DISARANKAN — Tanpa ini bot terbuka untuk publik
# ------------------------------------------------------------

# Comma-separated Telegram User ID yang diizinkan memakai bot.
# Cara cek User ID Anda: chat @userinfobot di Telegram.
# Contoh 1 user:  123456789
# Contoh 2 user:  123456789,987654321
# Kalau dikosongkan: SIAPA PUN yang tahu username bot bisa akses.
TELEGRAM_ALLOWED_IDS=


# ------------------------------------------------------------
# OPSIONAL — Keamanan tambahan
# ------------------------------------------------------------

# Secret token untuk verifikasi header dari Telegram.
# Telegram akan mengirim header X-Telegram-Bot-Api-Secret-Token
# di setiap request webhook. Worker menolak jika tidak cocok.
# Generate dengan: openssl rand -hex 32
# Kalau diisi, HARUS force re-register webhook setelah deploy:
#   https://<worker-url>/telegram/setup?token=<ADMIN_TOKEN>
WEBHOOK_SECRET=